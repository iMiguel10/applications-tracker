            "description": "Elementos de la página pedida."
          },
          "total": {
            "type": "integer",
            "title": "Total",
            "description": "Total de elementos que cumplen el filtro."
          },
          "page": {
            "type": "integer",
            "title": "Page",
            "description": "Página devuelta, empezando en 1."
