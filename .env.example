# Application
ENV=development

# PostgreSQL
POSTGRES_DB=applications_tracker
POSTGRES_USER=applications_tracker
POSTGRES_PASSWORD=applications_tracker_dev

# Database connection
DATABASE_URL=postgresql+asyncpg://applications_tracker:applications_tracker_dev@db:5432/applications_tracker

# CORS
CORS_ORIGINS=http://localhost:5173

# Frontend
VITE_API_URL=http://localhost:8000
# Manual de uso al que lleva la ayuda de la app (servicio `manual`, que solo sirve el español)
VITE_MANUAL_URL=http://localhost:3001/

# SuperTokens: BD propia del core
SUPERTOKENS_DB_NAME=supertokens
SUPERTOKENS_DB_USER=supertokens
SUPERTOKENS_DB_PASSWORD=supertokens_dev

# SuperTokens: conexión API -> core (API key de al menos 20 caracteres)
SUPERTOKENS_CONNECTION_URI=http://supertokens:3567
SUPERTOKENS_API_KEY=supertokens-dev-api-key-change-me

# Dominios para las cookies de sesión: usar siempre localhost, nunca 127.0.0.1
API_DOMAIN=http://localhost:8000
WEBSITE_DOMAIN=http://localhost:5173

# Cola de trabajos (SAQ sobre Valkey): obligatoria, la api no arranca sin ella
VALKEY_URL=redis://valkey:6379/0

# Firma los enlaces de baja de los avisos por email (F12). Al menos 32 caracteres;
# en producción, uno aleatorio: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=dev-app-secret-change-me-0123456789abcdef

# Raíz del almacén de ficheros (volumen files_data): obligatoria
FILES_ROOT=/data/files

# Correo (RNF-34). En desarrollo, Mailpit (http://localhost:8025). Sin SMTP_HOST
# la aplicación arranca igual, pero no envía ningún email. Con SMTP_HOST,
# EMAIL_FROM es obligatorio. SMTP_SECURITY: none, starttls o tls.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=Applications Tracker <no-reply@applications-tracker.localhost>

# Registro (decisión 0022). Con false, nadie puede crearse una cuenta y las crea quien
# administra: docker compose exec api python -m app.scripts.create_user ana@example.com
# SIGNUP_ENABLED=true

# Límites por cuenta (RF-140). Opcionales: sin ellas valen los de la especificación §10.
# Una cuenta concreta puede tener otros con app/scripts/set_user_limit.py.
# LIMIT_APPLICATIONS=5000
# LIMIT_COMPANIES=2000
# LIMIT_REMINDERS=5000
# LIMIT_DOCUMENTS=100
# LIMIT_STORAGE_BYTES=104857600   # en bytes (100 MB); siempre con tope
# DOCUMENT_MAX_BYTES=5242880      # tamaño máximo de cada PDF subido (5 MB)

# Rate limiting (RNF-04). TRUSTED_PROXIES: IPs o redes CIDR de los proxies propios,
# separadas por comas; solo de ellos se acepta X-Forwarded-For. En desarrollo no hay
# proxy. En producción, detrás de Nginx, es OBLIGATORIO poner su IP: si no, todos los
# usuarios compartirían la del proxy y el límite de inicios de sesión.
# RATE_LIMIT_ENABLED=true
# TRUSTED_PROXIES=

# IA (F15, decisiones 0017, 0019 y 0020). La plataforma sirve los usos gratuitos con
# su proveedor y modelo; sin AI_PLATFORM_PROVIDER no hay uso gratuito y la IA solo
# funciona con claves propias. Por defecto, el Ollama del compose (sin clave ni coste
# por uso). Antes del primer uso, descarga el modelo una vez:
#   docker compose exec ollama ollama pull qwen3:8b
# Comprobarlo: docker compose exec api python -m app.scripts.check_ai_provider
AI_PLATFORM_PROVIDER=ollama
AI_PLATFORM_MODEL=qwen3:8b
AI_OLLAMA_BASE_URL=http://ollama:11434
# AI_OLLAMA_CONTEXT_TOKENS=16384   # entrada y salida juntas; más, más memoria de GPU
# Un modelo local es más lento que uno en la nube (con la CPU, bastante más).
AI_REQUEST_TIMEOUT_SECONDS=300
# Con un proveedor en la nube, el modelo y la clave son obligatorios, y el precio por
# millón de tokens (USD) solo estima el coste de cada propuesta. Con Groq:
# AI_PLATFORM_PROVIDER=groq
# AI_PLATFORM_MODEL=openai/gpt-oss-120b
# AI_PLATFORM_API_KEY=
# AI_PLATFORM_INPUT_USD_PER_MTOK=0.15
# AI_PLATFORM_OUTPUT_USD_PER_MTOK=0.60
# AI_REQUEST_TIMEOUT_SECONDS=120

# Usos gratuitos por cuenta y tarea (no se renuevan). Un número, o "unlimited" para
# quitar el tope a todas las cuentas: con un proveedor de pago, el gasto queda sin
# límite. Una cuenta concreta puede tener otro número con set_user_limit.
# LIMIT_AI_CV_PROPOSALS=1
# LIMIT_AI_COVER_LETTER_PROPOSALS=1

# Claves propias: cada usuario puede usar su clave de Anthropic, OpenAI o Groq, sin
# límite de usos. Se cifran con estas claves maestras (Fernet), separadas por comas
# y la nueva primero; sin ellas no se ofrecen claves propias. Generar una:
#   docker compose exec api python -m app.scripts.rotate_ai_keys --new-key
AI_KEYS_ENCRYPTION_KEYS=
# Modelos que cada usuario puede elegir con su clave, separados por comas; el primero
# es el recomendado. Un proveedor con la lista vacía no se ofrece.
AI_ANTHROPIC_MODELS=claude-sonnet-5-5,claude-haiku-5-5
AI_OPENAI_MODELS=gpt-5.5,gpt-5.4-mini
AI_GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
