# Variables de PRODUCCIÓN (compose.prod.yml, F7). En Coolify van en el panel del
# recurso (Environment Variables); en otro servidor, en un .env junto al compose.
# Nunca se versionan con valores reales. Explicación de cada una en el manual
# (Despliegue › Variables).
#
# Cambiar una variable exige volver a desplegar. APP_URL, además, reconstruye la
# imagen `web`: el frontend la lleva dentro.

# --- Obligatorias --------------------------------------------------------------

# Origen público, con https y sin barra final. Es la web y también la API (0023).
APP_URL=https://tracker.example.com

# Secretos: uno distinto cada uno, generados al instalar. Por ejemplo:
#   openssl rand -hex 32
POSTGRES_PASSWORD=
SUPERTOKENS_DB_PASSWORD=
SUPERTOKENS_API_KEY=
# Firma los enlaces de baja de los avisos. Cambiarlo invalida los ya enviados.
APP_SECRET=

# --- Registro (decisión 0022) --------------------------------------------------

# Cerrado por defecto en producción: las cuentas las crea quien administra con
#   python -m app.scripts.create_user ana@example.com
# (en Coolify, en la terminal del contenedor `api`). Sin correo, el script imprime el
# enlace para elegir la contraseña. Con true, cualquiera puede registrarse.
# SIGNUP_ENABLED=false

# --- Cuenta de demostración --------------------------------------------------------

# Contraseña (pública) de demo@example.com. Solo hace falta si usas la cuenta de
# demostración: `python -m app.scripts.reset_demo` la recrea con esta contraseña y
# unos límites bajos. Prográmalo cada día (manual: Cuenta de demostración).
# DEMO_PASSWORD=

# --- Claves de IA propias de los usuarios ----------------------------------------

# Sin claves maestras no se ofrecen. Una clave Fernet:
#   openssl rand -base64 32 | tr '+/' '-_'
# Se cifra con la primera y se descifra con cualquiera (rotación: la nueva delante).
AI_KEYS_ENCRYPTION_KEYS=
# Modelos que cada usuario puede elegir, separados por comas (el primero, el
# recomendado). Vacía, el proveedor no se ofrece. Sin poner, los de compose.prod.yml.
# AI_ANTHROPIC_MODELS=
# AI_OPENAI_MODELS=
# AI_GROQ_MODELS=

# --- Correo (opcional, RNF-34) ---------------------------------------------------

# Sin SMTP_HOST la aplicación funciona igual, pero no envía nada: ni avisos, ni
# recuperación de contraseña, ni verificación (y entonces no se exige verificar).
# SMTP_SECURITY: starttls (587, por defecto), tls (465) o none.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM=Applications Tracker <no-reply@example.com>
# SMTP_TIMEOUT_SECONDS=30            # tiempo máximo de cada envío

# --- IA de la plataforma (opcional) ----------------------------------------------

# Sirve los usos gratuitos. Sin AI_PLATFORM_PROVIDER no hay: la IA solo funciona con
# la clave propia de cada usuario.
#
# Con un proveedor de pago (groq, anthropic u openai):
# AI_PLATFORM_PROVIDER=groq
# AI_PLATFORM_MODEL=openai/gpt-oss-120b
# AI_PLATFORM_API_KEY=
# AI_PLATFORM_INPUT_USD_PER_MTOK=0.15    # solo para estimar el coste de cada uso
# AI_PLATFORM_OUTPUT_USD_PER_MTOK=0.60
#
# Con Ollama, un servicio externo identificado por su URL (otra máquina con GPU, o
# un recurso aparte en Coolify conectado a la red del stack):
# AI_PLATFORM_PROVIDER=ollama
# AI_PLATFORM_MODEL=qwen3:8b
# AI_OLLAMA_BASE_URL=http://192.168.1.50:11434
# AI_OLLAMA_CONTEXT_TOKENS=16384
# AI_REQUEST_TIMEOUT_SECONDS=300
#
# Usos gratuitos por cuenta y tarea (no se renuevan): un número, o "unlimited".
# LIMIT_AI_CV_PROPOSALS=1
# LIMIT_AI_COVER_LETTER_PROPOSALS=1

# --- Límites por cuenta (opcional, RF-140) ---------------------------------------

# Sin poner, los de la especificación §10.
# LIMIT_APPLICATIONS=5000
# LIMIT_COMPANIES=2000
# LIMIT_REMINDERS=5000
# LIMIT_DOCUMENTS=100
# LIMIT_STORAGE_BYTES=104857600    # en bytes (100 MB)
# DOCUMENT_MAX_BYTES=5242880       # tamaño máximo de cada PDF (5 MB; Nginx admite hasta 25 MB)

# --- Base de datos (opcional) ----------------------------------------------------

# Nombre y usuario de la BD de la aplicación. Sin poner: applications_tracker.
# POSTGRES_DB=applications_tracker
# POSTGRES_USER=applications_tracker

# --- Copias de seguridad (servicio `backup`) -----------------------------------------

# Cada noche, las dos BD y los ficheros a una carpeta del servidor (no a un volumen:
# así se ven y se pueden llevar a un NAS o un disco externo). La hora es la de TZ.
# BACKUP_HOST_DIR=/var/backups/applications-tracker
# TZ=Europe/Madrid
# BACKUP_SCHEDULE=0 3 * * *        # formato cron
# Las 7 más recientes y, además, la última de cada una de las 4 semanas anteriores.
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# El contenedor sale como unhealthy si la última copia falló o tiene más de estas horas.
# BACKUP_MAX_AGE_HOURS=26
#
# Envío fuera del servidor (opcional): una cadena de conexión de rclone. Se copia cada
# copia nueva; nunca se borra nada allí (su retención, con las reglas del almacén).
# Ejemplos (las contraseñas de sftp/smb, ofuscadas con `rclone obscure`):
#   :s3,provider=Cloudflare,access_key_id=…,secret_access_key=…,endpoint=https://<cuenta>.r2.cloudflarestorage.com:bucket/applications-tracker
#   :sftp,host=nas.local,user=backup,pass=<ofuscada>:/volume1/backups/applications-tracker
# BACKUP_RCLONE_REMOTE=
