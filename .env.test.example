ENV=test

POSTGRES_DB=applications_tracker_test
POSTGRES_USER=applications_tracker_test
POSTGRES_PASSWORD=applications_tracker_dev

DATABASE_URL=postgresql+asyncpg://applications_tracker_test:applications_tracker_dev@db-test:5432/applications_tracker_test

CORS_ORIGINS=http://localhost:5173

SUPERTOKENS_CONNECTION_URI=http://supertokens-test:3567
SUPERTOKENS_API_KEY=supertokens-test-api-key-0123456789
API_DOMAIN=http://localhost:8000
WEBSITE_DOMAIN=http://localhost:5173

VALKEY_URL=redis://valkey-test:6379/0
# Las pruebas del almacén usan un directorio temporal propio (tmp_path); esta
# raíz solo satisface la configuración.
FILES_ROOT=/tmp/files

# Límites por cuenta (RF-140). Opcionales: sin ellas valen los de la especificación §10.
# Una cuenta concreta puede tener otros con app/scripts/set_user_limit.py.
# LIMIT_APPLICATIONS=5000
# LIMIT_COMPANIES=2000
# LIMIT_REMINDERS=5000
